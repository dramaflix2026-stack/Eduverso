# Configuração do Eduverso. NÃO colocar segredos com NEXT_PUBLIC_.
# Supabase Auth ainda não integrado à interface: nenhum projeto Eduverso vinculado.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Integração opcional de geração de conteúdo médico (desabilitada por padrão).
# Só habilitar após login real e limites de consumo por usuário.
EDUVERSO_AI_ENABLED=false
EDUVERSO_AI_CHAT_COMPLETIONS_URL=
EDUVERSO_AI_MODEL=
EDUVERSO_AI_API_KEY=
# O endpoint /api/medicina/gerar usa credencial de API APENAS no servidor,
# exige token Bearer Supabase validado e tem limite preliminar local em memória.
# Antes de escalar, substituir o limite em memória por quota transacional persistente.
